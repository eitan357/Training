{
  "hosting": {
    "site": "training-diary",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "headers": [
      {
        "source": "manifest.json",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.png",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.svg",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/migrate",
        "destination": "/migrate.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
